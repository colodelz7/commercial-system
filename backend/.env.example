# Copie este arquivo para .env e preencha com seus valores.
# Rodando local com Docker: `docker compose up -d` na raiz do projeto sobe o Postgres.

# ---- PostgreSQL local (Docker, ver docker-compose.yml na raiz) ----
PGHOST=localhost
PGPORT=5432
PGUSER=comercial
PGPASSWORD=dev_local_only
PGDATABASE=comercial

# ---- Autenticação (bcrypt + JWT em cookie httpOnly) ----
JWT_SECRET=
JWT_EXPIRA=12h
# Local em HTTP: precisa ser false. Se um dia for HTTPS, mude para true.
COOKIE_SECURE=false
# Opcional: senha do admin semeado no 1º boot (mín. 6 caracteres). Se não
# definir, uma senha aleatória é gerada e impressa uma vez no log do backend.
ADMIN_SEED_PASSWORD=

# ---- Anexos ----
UPLOAD_DIR=./uploads-local

# ---- CORS / origem do frontend em dev ----
ALLOWED_ORIGIN=http://localhost:5173

# ---- Assinatura digital (Autentique) — opcional ----
AUTENTIQUE_TOKEN=
WEBHOOK_SECRET=
CRIADOR_EMAIL=

# ---- Meta Ads (captura de leads) — opcional ----
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
# Segredo do app (Configurações > Básico) — SEM ele o webhook não processa
# nada, mesmo com os dois acima preenchidos (protege contra POST forjado).
META_APP_SECRET=

# ---- Avisos por e-mail / WhatsApp — opcional ----
MAIL_USER=
MAIL_PASS=
MAIL_TO=
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=

# ---- MorningBot (assistente no botão flutuante) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Servidor ----
PORT=3000
