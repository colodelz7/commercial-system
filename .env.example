# Copie para .env (mesma pasta) antes de rodar `docker compose up -d`.
# Precisa bater com PGUSER/PGPASSWORD/PGDATABASE em backend/.env.
POSTGRES_USER=comercial
# Gere uma senha própria e forte. NÃO use um valor de exemplo: valor sugerido
# em arquivo versionado vira senha de produção e fica público junto com o código.
# Ex.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=comercial
